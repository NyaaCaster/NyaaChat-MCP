# NyaaChat-MCP environment configuration
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored.

# --- HTTP server ---
# Port the MCP server listens on inside the container.
# The host-side port mapping is defined in docker-compose.yml.
MCP_PORT=3094

# Bind address. Inside Docker we listen on all interfaces.
MCP_HOST=0.0.0.0

# 公网测试脚本 (scripts/test-public.mjs) 用的目标 MCP 端点，必填
MCP_URL=

# Bearer token(s) required by clients in `Authorization: Bearer <key>`.
# Two equivalent ways to declare keys:
#
#   1) MCP_API_KEY=<key>           — single key, label internally tagged as "DEFAULT"
#   2) MCP_API_KEY_<LABEL>=<key>   — labeled key (any number of these); the part after
#                                     "MCP_API_KEY_" becomes the label (uppercase letters /
#                                     digits / underscores recommended). Use this to issue
#                                     different keys to different groups so each can be
#                                     rotated / revoked independently. The label is logged
#                                     on every successful request (`[mcp] auth ok via X`),
#                                     useful for per-group traffic auditing.
#
# Both forms can be mixed. Leave all empty to disable auth (development only — server
# logs a startup warning).
#
# Generate a key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=

# Examples (uncomment + fill in):
#MCP_API_KEY_PUBLIC=
#MCP_API_KEY_FRIENDS=
#MCP_API_KEY_DND_GROUP=

# --- Time zone ---
# IANA timezone used by the time tool and log timestamps.
TZ=Asia/Shanghai

# --- QWeather (https://dev.qweather.com/) ---
# All QWeather-related settings are namespaced under QWEATHER_API_*
# so they don't collide with generic names like HOST / KEY.
# Used by the weather tool. Leave blank until weather logic is implemented.

# API Host (per-account subdomain)
#   https://console.qweather.com/setting?lang=zh
QWEATHER_API_HOST=

# API Key (Bearer token used in the Authorization header)
#   https://console.qweather.com/project?lang=zh
QWEATHER_API_KEY=

# Default location: "longitude,latitude" or a QWeather LocationID.
# 116.41,39.92 = Beijing.
QWEATHER_API_DEFAULT_LOCATION=116.41,39.92

# --- 网络搜索（web_search 工具）---
# 后端开关：tavily 或 searxng。决定 web_search 工具走哪套搜索逻辑。
# 留空 / 不设置时默认 searxng（无需任何凭证，开箱即用）。
#WEB_SEARCH_BACKEND=searxng

# --- Tavily（https://app.tavily.com/）---
# WEB_SEARCH_BACKEND=tavily 时必填。逗号分隔的 API key 列表，按顺序轮询：
# 当前 key 遇到额度耗尽（HTTP 432/433）、限流（429）或 key 无效（401）时
# 自动切换到下一个。至少填一个。
#TAVILY_API_KEYS=tvly-xxx,tvly-yyy,tvly-zzz

# Tavily 请求超时（毫秒，可选）。默认 8000。
#TAVILY_TIMEOUT_MS=8000

# --- SearXNG ---
# 服务端直接请求自建的 SearXNG 元搜索实例（format=json）。
# 默认值已硬编码，开箱即用；仅当你要指向自己的实例时才需取消下一行注释并覆盖。
#SEARXNG_URL=http://j.hony-wen.com:1441/search

# 请求超时（毫秒，可选）。默认 8000。
#SEARXNG_TIMEOUT_MS=8000
