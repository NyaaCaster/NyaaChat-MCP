# NyaaChat-MCP environment configuration
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored.

# --- HTTP server ---
# Port the MCP server listens on inside the container.
# The host-side port mapping is defined in docker-compose.yml.
MCP_PORT=3094

# Bind address. Inside Docker we listen on all interfaces.
MCP_HOST=0.0.0.0

# Shared secret required by clients in the `Authorization: Bearer <key>` header.
# Leave empty/unset to disable auth (development only — server logs a warning).
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_API_KEY=

# --- Time zone ---
# IANA timezone used by the time tool and log timestamps.
TZ=Asia/Shanghai

# --- QWeather (https://dev.qweather.com/) ---
# All QWeather-related settings are namespaced under QWEATHER_API_*
# so they don't collide with generic names like HOST / KEY.
# Used by the weather tool. Leave blank until weather logic is implemented.

# API Host (per-account subdomain)
#   https://console.qweather.com/setting?lang=zh
QWEATHER_API_HOST=

# API Key (Bearer token used in the Authorization header)
#   https://console.qweather.com/project?lang=zh
QWEATHER_API_KEY=

# Default location: "longitude,latitude" or a QWeather LocationID.
# 116.41,39.92 = Beijing.
QWEATHER_API_DEFAULT_LOCATION=116.41,39.92
