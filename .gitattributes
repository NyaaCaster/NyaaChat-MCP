# Normalize line endings for text files
* text=auto eol=lf

# Force LF for shell scripts and config
*.sh    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.ts    text eol=lf
*.md    text eol=lf

# Keep CRLF for PowerShell scripts on Windows
*.ps1   text eol=crlf

# Treat lockfiles as binary in diffs
package-lock.json -diff
